;;; keyboard.el.in --- Actual offline workflow keymaps -*- lexical-binding: t; -*-
(select-window (frame-selected-window))
(ogent-armory-actions ogent-workflow-root "review")
(delete-other-windows)
(goto-char (point-min))
(forward-line 1)
(let ((id (tabulated-list-get-id)))
  (execute-kbd-macro (kbd "RET"))
  (cl-assert (eq major-mode 'ogent-armory-proposal-mode))
  (cl-assert (string-match-p "0 9 \\* \\* 1" (buffer-string)))
  (execute-kbd-macro (kbd "q"))
  (cl-assert (eq major-mode 'ogent-armory-actions-mode))
  (cl-assert (equal id (tabulated-list-get-id)))
  (execute-kbd-macro (kbd "a"))
  (cl-assert (equal "approved" (plist-get (car (ogent-armory-actions-read ogent-workflow-root "review")) :status)))
  (cl-assert (null (ogent-armory-list-jobs ogent-workflow-root "builder")))
  (execute-kbd-macro (kbd "d"))
  (cl-assert (= 1 (length (ogent-armory-list-jobs ogent-workflow-root "builder"))))
  (execute-kbd-macro (kbd "g r"))
  (cl-assert (equal id (tabulated-list-get-id))))
(forward-line 1)
(cl-assert (condition-case nil (progn (execute-kbd-macro (kbd "a")) nil) (user-error t)))
(execute-kbd-macro (kbd "RET"))
(cl-assert (string-match-p "Invalid proposal" (buffer-string)))
(execute-kbd-macro (kbd "q"))
(ogent-show-errors)
(cl-assert (eq major-mode 'ogent-errors-mode))
(execute-kbd-macro (kbd "RET"))
(cl-assert (eq major-mode 'org-mode))
(cl-assert (looking-at "\\*+ Request:"))
(ogent-show-errors)
(ogent-errors-render)
(execute-kbd-macro (kbd "r"))
(cl-assert (eq major-mode 'org-mode))
(sit-for 3)
(cl-assert (eq (ogent-ui-request-status (car ogent-ui--request-history)) 'done))
(setq ogent-workflow-draft (ogent-armory-compose-buffer ogent-workflow-root "builder"))
(delete-other-windows)
(execute-kbd-macro (vconcat (kbd "i") (string-to-vector "Review the local notes.") (kbd "ESC")))
(ogent-armory-compose-add-attachment (expand-file-name "notes/review.org" ogent-workflow-root))
(goto-char (point-max))
(execute-kbd-macro (vconcat (kbd "a") (string-to-vector "\nKeep this editable.") (kbd "ESC")))
(let ((ogent-armory-runner-confirm-before-run nil))
  (cl-letf (((symbol-function 'ogent-armory-runtime-picker)
             (lambda (&optional _prompt) '(:runtime-mode headless))))
    (execute-kbd-macro (kbd "C-c C-c"))))
(cl-assert (string-prefix-p "*ogent-armory-agent:" (buffer-name)))
(setq ogent-workflow-process (get-buffer-process (current-buffer)))
(sit-for 3)
(cl-assert (not (process-live-p ogent-workflow-process)))
(let* ((id (process-get ogent-workflow-process 'ogent-armory-conversation-id))
       (file (ogent-armory-conversation-file ogent-workflow-root id)))
  (ogent-armory-conversation ogent-workflow-root file)
  (cl-assert (string-match-p "The native workflow review is complete" (buffer-string))))
(cl-assert (string-match-p "Keep this editable" (with-current-buffer ogent-workflow-draft (buffer-string))))
(with-temp-buffer
  (insert-file-contents (expand-file-name "runner-prompt.txt" ogent-workflow-root))
  (cl-assert (not (string-match-p "attachment:" (buffer-string)))))
(with-temp-file "/work/docs/experiments/emacs-workflows/keyboard-proof.json"
  (insert (json-serialize
           (list :emacs emacs-version :org (org-version)
                 :evil (if (featurep 'evil) evil-version "absent")
                 :magit_sections (if (featurep 'magit-section) t :false)
                 :provider_requests :false
                 :fixture_http_requests ogent-workflow-request-count
                 :active_requests (length (ogent-ui-active-requests))
                 :checks ["detail/back preserves row" "approval does not dispatch"
                          "dispatch creates one owned job" "refresh preserves identity"
                          "invalid approval guarded" "RET visits original request"
                          "r retries immutable context and completes"
                          "attachment remains editable and absent from instructions"
                          "submit displays real local process" "result conversation is durable"]))))
(message "Workflow keys passed: detail/back, approve/dispatch, invalid guard, visit/retry, attach/edit/submit/result; fixture traffic only")
