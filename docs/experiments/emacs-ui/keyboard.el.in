;;; keyboard.el.in --- Exercise actual UI keymaps offline -*- lexical-binding: t; -*-
;; Load into the isolated capture instance through emacsclient.
(with-selected-window (frame-selected-window)
  (ogent-armory-home ogent-ui-capture-root)
  (delete-other-windows)
  (execute-kbd-macro (kbd "j a n RET"))
  (cl-assert (eq major-mode 'ogent-armory-agent-mode))
  (execute-kbd-macro (kbd "g r q"))
  (cl-assert (eq major-mode 'ogent-armory-agents-mode))
  (execute-kbd-macro (vconcat (kbd "f") (string-to-vector "strategy") (kbd "RET")))
  (cl-assert (equal ogent-armory-agents--query "strategy"))
  (cl-assert (equal (mapcar #'car (ogent-armory-agents--entries)) '("cto")))
  (execute-kbd-macro (kbd "D"))
  (cl-assert (= 14 (length tabulated-list-format)))
  (execute-kbd-macro (kbd "f C-a C-k RET"))
  (cl-assert (string-empty-p ogent-armory-agents--query))
  (ogent-armory-home ogent-ui-capture-root)
  (execute-kbd-macro (vconcat (kbd "c") (string-to-vector "cto") (kbd "RET")))
  (cl-assert (eq major-mode 'ogent-armory-compose-mode))
  (let ((draft (current-buffer)))
    (execute-kbd-macro (vconcat (kbd "i")
                              (string-to-vector "Review the native UI before running anything.")
                              (kbd "ESC")))
    (let ((text (buffer-string)))
      (ogent-armory-home ogent-ui-capture-root)
      (ogent-armory-home-refresh)
      (cl-assert (equal text (with-current-buffer draft (buffer-string)))))
    (kill-buffer draft))
  (ogent-models-browse)
  (execute-kbd-macro (kbd "n n"))
  (let ((id (ogent-ui-models--browser-model-at-point)))
    (cl-assert id)
    (execute-kbd-macro (kbd "D g r D"))
    (cl-assert (equal id (ogent-ui-models--browser-model-at-point))))
  (execute-kbd-macro (vconcat (kbd "/") (string-to-vector "claude-fable-5-1")
                            (kbd "RET")))
  (cl-assert (equal "claude-fable-5-1" (ogent-ui-models--browser-model-at-point)))
  (ogent-armory-home ogent-ui-capture-root)
  (goto-char (point-min))
  (search-forward "Needs Attention")
  (beginning-of-line)
  (execute-kbd-macro (kbd "TAB"))
  (let ((hidden (oref (magit-current-section) hidden)))
    (ogent-armory-home-refresh)
    (cl-assert (equal hidden (oref (magit-current-section) hidden))))
  (execute-kbd-macro (kbd "TAB"))
  (goto-char (point-min))
  (message "Native keyboard journey passed; provider request guards remained active"))
