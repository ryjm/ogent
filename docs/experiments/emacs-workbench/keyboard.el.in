;;; keyboard.el.in --- Actual keys in the owned workflow -*- lexical-binding: t; -*-
(select-window (frame-selected-window))
(switch-to-buffer ogent-workbench-fixture-source)
(delete-other-windows)
(execute-kbd-macro (kbd "C-c . C-b l"))
(cl-assert (eq major-mode 'ogent-workbench-comments-mode))
(goto-char (point-min))
(execute-kbd-macro (kbd "n"))
(let ((selected (get-text-property (point) 'ogent-comment)))
  (cl-assert selected)
  (execute-kbd-macro (kbd "g r"))
  (cl-assert (eq selected (get-text-property (point) 'ogent-comment)))
  (execute-kbd-macro (kbd "RET"))
  (cl-assert (eq (current-buffer) ogent-workbench-fixture-source))
  (let ((range (evil-visual-range)))
    (cl-assert (equal (buffer-substring-no-properties (car range) (cadr range))
                      (plist-get selected :text)))))
(let ((ogent-edit-diff--magit-available nil))
  (pop-to-buffer (ogent-edit-diff-show ogent-workbench-fixture-edits))
  (delete-other-windows)
  (goto-char (point-min))
  (execute-kbd-macro (kbd "n"))
  (execute-kbd-macro (vconcat (kbd "c") (string-to-vector "Keep this concrete opening.") (kbd "RET")))
  (execute-kbd-macro (kbd "a")))
(with-current-buffer ogent-workbench-fixture-source
  (cl-assert (string-match-p "Mark a passage, leave a comment" (buffer-string)))
  (cl-assert (string-match-p "Your notes, decisions, and source material stay in ordinary Org files" (buffer-string))))
(switch-to-buffer ogent-workbench-fixture-todo)
(goto-char (point-min)) (org-next-visible-heading 1)
(execute-kbd-macro (kbd "C-c . C-b p"))
(cl-assert (eq major-mode 'ogent-task-patch-mode))
(goto-char (point-min)) (re-search-forward "^@@") (beginning-of-line)
(execute-kbd-macro (vconcat (kbd "C-c C-m")
                            (string-to-vector "Keep the argument name and check the Ada greeting.")
                            (kbd "RET")))
(execute-kbd-macro (kbd "C-c C-r"))
(let ((deadline (+ (float-time) 10)))
  (while (and (gethash (plist-get ogent-workbench-fixture-task :file) ogent-task--active)
              (< (float-time) deadline))
    (accept-process-output nil .02)))
(cl-assert (equal (plist-get (ogent-task--read (plist-get ogent-workbench-fixture-task :file)) :checks) "passed"))
(with-temp-buffer
  (insert-file-contents (expand-file-name "runner-runs.log" ogent-workbench-fixture-root))
  (cl-assert (= (count-lines (point-min) (point-max)) 2)))
(execute-kbd-macro (kbd "g r"))
(cl-assert (string-match-p "Checks: passed" (buffer-string)))
(execute-kbd-macro (kbd "C-c C-o"))
(cl-assert (equal buffer-file-name (plist-get ogent-workbench-fixture-task :file)))
(cl-assert (string-match-p "Keep the argument name" (buffer-string)))
(cl-assert (string-match-p "SUBMITTED" (buffer-string)))
(switch-to-buffer ogent-workbench-fixture-todo)
(goto-char (point-min)) (org-next-visible-heading 1)
(ogent-task-review)
(execute-kbd-macro (kbd "C-c C-c"))
(cl-assert (equal "applied" (plist-get (ogent-task--read ogent-task-patch--file) :status)))
(with-temp-buffer
  (insert-file-contents (expand-file-name "greeting.py" ogent-workbench-fixture-project))
  (cl-assert (string-match-p "Hello, {name}!" (buffer-string))))
(with-current-buffer ogent-workbench-fixture-todo
  (cl-assert (equal (org-get-todo-state) "TODO")))
;; The same reader also works when Evil is disabled locally.
(switch-to-buffer ogent-workbench-fixture-source)
(ogent-workbench-comments)
(evil-local-mode -1)
(goto-char (point-min))
(execute-kbd-macro (kbd "n g RET"))
(cl-assert (eq (current-buffer) ogent-workbench-fixture-source))
(switch-to-buffer (get-buffer-create "inclusive-selection.org"))
(org-mode) (ogent-mode 1)
(erase-buffer)
(insert "Include the last character.")
(evil-normal-state)
(execute-kbd-macro (kbd "g g 0 v $"))
(execute-kbd-macro (vconcat (kbd "C-c . C-l") (string-to-vector "Keep every character.") (kbd "RET")))
(cl-assert (equal (plist-get (car ogent-workbench--records) :text)
                  "Include the last character."))
(with-temp-file (or (getenv "OGENT_WORKBENCH_PROOF")
                    "/work/docs/experiments/emacs-workbench/keyboard-proof.json")
  (insert (json-serialize
           (list :emacs emacs-version :org (org-version) :evil evil-version
                 :provider_requests :false :actual_owned_cli_runs 2
                 :terminal (if (display-graphic-p) :false t)
                 :ascii (if ogent-theme-use-unicode :false t)
                 :checks ["work menu opens comments" "refresh preserves selection"
                          "RET selects source passage" "native fallback refines and accepts via n/c/a"
                          "kept text preserved" "work menu returns task patch"
                          "hunk comment persists" "revision runs owned CLI and real check"
                          "result key visits durable record" "apply updates original checkout"
                          "TODO state stays under user control" "reader works with local Evil disabled"
                          "inclusive Evil selection preserves last character"]))))
(message "Passage and TODO keys passed; owned fixtures only")
