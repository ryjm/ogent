+(defun ogent-tool-execution-copy-data (value)
+  "Copy mutable strings, lists, vectors and object tables in contract VALUE."
+  (cond ((functionp value) value)
+        ((stringp value) (copy-sequence value))
+        ((hash-table-p value)
