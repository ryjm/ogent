+(defun ogent-agent-execution-tests--raw-root-contract (tool)
+  "Check TOOL refuses explicit and default raw roots in every format."
+  (let* ((root (ogent-test--provision-store-directory 'tools))
+         (raw (expand-file-name (unibyte-string 255) root))
+         (valid (expand-file-name "λ-root" root))
+         (args (if (equal tool "files") '(:pattern "*.el")
+                 '(:pattern "needle" :glob_filter "*.el")))
+         (ogent-tool-registry (copy-tree ogent-tools-default-registry))
+         (ogent-ledger-enabled nil))
+    (make-directory raw)
+    (make-directory valid)
+    (should (file-directory-p raw))
+    (dolist (state '(empty excluded))
+      (when (eq state 'excluded)
+        (ogent-agent-execution-tests--file raw "ignored.txt" "needle"))
+      (dolist (explicit '(nil t))
+        (let* ((ogent-tools-project-root raw)
+               (arguments (if explicit (append args (list :path raw)) args)))
+          (dolist (format '(plist json))
+            (let ((result (ogent-agent-call tool arguments format)))
+              (when (eq format 'json)
+                (setq result (json-parse-string result :object-type 'plist)))
+              (should (equal (plist-get result :status) "error"))
+              (should (equal (plist-get (plist-get result :error) :code) "unsupported_output")))
+            (let ((callbacks 0) result)
+              (ogent-agent-call-async
+               tool arguments (lambda (data) (cl-incf callbacks) (setq result data)) format)
+              (when (eq format 'json)
+                (setq result (json-parse-string result :object-type 'plist)))
+              (should (= callbacks 1))
+              (should (equal (plist-get result :status) "error"))
+              (should (equal (plist-get (plist-get result :error) :code) "unsupported_output")))))))
+    (ogent-agent-execution-tests--file valid "good.el" "needle")
+    (let* ((result (ogent-agent-call tool (append args (list :path valid))))
+           (data (plist-get result :data)))
+      (should (equal (plist-get result :status) "ok"))
+      (should (= (plist-get data (if (equal tool "files") :total_files :total_matches)) 1))
+      (should (json-serialize data :false-object :json-false :null-object :json-null)))))
+
+(ert-deftest ogent-agent-execution-glob-raw-root-contract ()
+  "Reject raw glob roots even when no selected file exposes their bytes."
+  (ogent-agent-execution-tests--raw-root-contract "files")
+  (let ((root (ogent-test--provision-store-directory 'tools))
+        (ogent-tool-registry (copy-tree ogent-tools-default-registry))
+        (ogent-ledger-enabled nil))
+    (dolist (format '(plist json))
+      (let ((result (ogent-agent-call "files" (list :pattern (unibyte-string 255) :path root) format)))
+        (when (eq format 'json)
+          (setq result (json-parse-string result :object-type 'plist)))
+        (should (equal (plist-get (plist-get result :error) :code) "unsupported_output"))))))
+
+(ert-deftest ogent-agent-execution-process-raw-root-contract ()
+  "Reject raw search roots before invoking a process or enumerating files."
+  (ogent-agent-execution-tests--raw-root-contract "search"))
+
