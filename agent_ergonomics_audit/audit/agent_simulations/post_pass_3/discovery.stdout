RESULT "{\"contract_version\":\"1\",\"tool\":{\"name\":\"read-file\",\"aliases\":[\"read_file\",\"read\",\"cat\"],\"description\":\"Read the contents of a file. Returns lines with line numbers.\",\"category\":\"filesystem\",\"enabled\":true,\"async\":false,\"async_sdk\":false,\"legacy_streaming\":false,\"boolean_representation\":\"native\",\"confirmation_required\":false,\"risk\":\"low\",\"arguments\":[{\"name\":\"file_path\",\"type\":\"string\",\"optional\":false,\"description\":\"Absolute path to the file to read\"},{\"name\":\"offset\",\"type\":\"integer\",\"optional\":true,\"description\":\"Line number to start from (1-indexed)\"},{\"name\":\"limit\",\"type\":\"integer\",\"optional\":true,\"description\":\"Maximum lines to read\"}],\"call_arguments\":[{\"name\":\"file_path\",\"type\":\"string\",\"optional\":false,\"description\":\"Absolute path to the file to read\"},{\"name\":\"offset\",\"type\":\"integer\",\"optional\":true,\"description\":\"Line number to start from (1-indexed)\"},{\"name\":\"limit\",\"type\":\"integer\",\"optional\":true,\"description\":\"Maximum lines to read\"},{\"name\":\"column\",\"type\":\"integer\",\"optional\":true,\"description\":\"Starting column for a continued long line (1-indexed)\"}],\"execution\":\"ogent-agent-call\",\"result\":\"structured data\",\"examples\":[\"(ogent-agent-call \\\"read-file\\\" '(:file_path \\\"README.org\\\" :limit 40))\"],\"effects\":[{\"kind\":\"read\",\"target\":\"file\",\"scope\":\"workspace\",\"risk\":\"low\"}]},\"result_schema\":\"(ogent-agent-schema 'json)\"}
"
FORM (help-function-arglist 'ogent-agent-call-async)
RESULT (name args callback &optional format)
FORM (documentation 'ogent-agent-call-async)
RESULT "Execute NAME with named ARGS and send its terminal result to CALLBACK.
Serialize that result according to FORMAT.  Return a process for asynchronous
tools; immediate results return nil.  CALLBACK accepts one result and runs
exactly once, including validation, denial, timeout and cancellation failures.
Cancel a returned process with `ogent-tool-process-cancel'."
FORM (documentation 'ogent-tool-process-cancel)
CONDITION (void-function ogent-tool-process-cancel)
