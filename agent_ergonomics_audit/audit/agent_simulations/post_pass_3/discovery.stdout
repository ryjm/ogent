FORM (require 'ogent)
RESULT ogent
FORM (ogent-agent-capabilities 'json)
RESULT "{\"contract_version\":\"1\",\"interface\":\"Emacs Lisp SDK\",\"tools\":[{\"name\":\"bash\",\"aliases\":[\"shell\",\"run\"],\"description\":\"Execute a shell command and return output.\",\"category\":\"shell\",\"enabled\":true,\"async\":false,\"async_sdk\":true,\"legacy_streaming\":true,\"boolean_representation\":\"native\",\"confirmation_required\":true,\"risk\":\"critical\",\"arguments\":[{\"name\":\"command\",\"type\":\"string\",\"optional\":false,\"description\":\"Shell command to execute\"},{\"name\":\"working_directory\",\"type\":\"string\",\"optional\":true,\"description\":\"Directory to run command in\"},{\"name\":\"timeout\",\"type\":\"number\",\"optional\":true,\"description\":\"Timeout in seconds\"}],\"call_arguments\":[{\"name\":\"command\",\"type\":\"string\",\"optional\":false,\"description\":\"Shell command to execute\"},{\"name\":\"working_directory\",\"type\":\"string\",\"optional\":true,\"description\":\"Directory to run command in\"},{\"name\":\"timeout\",\"type\":\"number\",\"optional\":true,\"description\":\"Timeout in seconds\"}],\"execution\":\"ogent-agent-call\",\"result\":\"structured data\",\"examples\":[\"(ogent-agent-call \\\"bash\\\" '(:command \\\"pwd\\\" :timeout 10))\"],\"effects\":[{\"kind\":\"execute\",\"target\":\"shell\",\"scope\":\"unrestricted\",\"risk\":\"critical\"},{\"kind\":\"read\",\"target\":\"filesystem\",\"scope\":\"unrestricted\",\"risk\":\"high\"},{\"kind\":\"write\",\"target\":\"filesystem\",\"scope\":\"unrestricted\",\"risk\":\"high\"},{\"kind\":\"network\",\"target\":\"external\",\"scope\":\"command\",\"risk\":\"high\"}]},{\"name\":\"edit-file\",\"aliases\":[\"edit_file\",\"edit\"],\"description\":\"Replace a string in a file. The old_string must be unique.\",\"category\":\"filesystem\",\"enabled\":true,\"async\":false,\"async_sdk\":false,\"legacy_streaming\":false,\"boolean_representation\":\"native\",\"confirmation_required\":true,\"risk\":\"high\",\"arguments\":[{\"name\":\"file_path\",\"type\":\"string\",\"optional\":false,\"description\":\"Absolute path to the file\"},{\"name\":\"old_string\",\"type\":\"string\",\"optional\":false,\"description\":\"Exact string to replace (must be unique in file)\"},{\"name\":\"new_string\",\"type\":\"string\",\"optional\":false,\"description\":\"Replacement string\"},{\"name\":\"replace_all\",\"type\":\"boolean\",\"optional\":true,\"description\":\"If true, replace all occurrences\"}],\"call_arguments\":[{\"name\":\"file_path\",\"type\":\"string\",\"optional\":false,\"description\":\"Absolute path to the file\"},{\"name\":\"old_string\",\"type\":\"string\",\"optional\":false,\"description\":\"Exact string to replace (must be unique in file)\"},{\"name\":\"new_string\",\"type\":\"string\",\"optional\":false,\"description\":\"Replacement string\"},{\"name\":\"replace_all\",\"type\":\"boolean\",\"optional\":true,\"description\":\"If true, replace all occurrences\"}],\"execution\":\"ogent-agent-call\",\"result\":\"value envelope\",\"examples\":[\"(ogent-agent-call \\\"edit-file\\\" '(:file_path \\\"notes.txt\\\" :old_string \\\"old text\\\" :new_string \\\"new text\\\"))\"],\"effects\":[{\"kind\":\"read\",\"target\":\"file\",\"scope\":\"workspace\",\"risk\":\"low\"},{\"kind\":\"write\",\"target\":\"file\",\"scope\":\"workspace\",\"risk\":\"high\"}]},{\"name\":\"glob\",\"aliases\":[\"find\",\"files\"],\"description\":\"Find files matching a glob pattern. Returns paths sorted by modification time.\",\"category\":\"search\",\"enabled\":true,\"async\":false,\"async_sdk\":false,\"legacy_streaming\":false,\"boolean_representation\":\"native\",\"confirmation_required\":false,\"risk\":\"low\",\"arguments\":[{\"name\":\"pattern\",\"type\":\"string\",\"optional\":false,\"description\":\"Glob pattern like **/*.el or src/**/*.py\"},{\"name\":\"path\",\"type\":\"string\",\"optional\":true,\"description\":\"Directory to search in (default: project root)\"}],\"call_arguments\":[{\"name\":\"pattern\",\"type\":\"string\",\"optional\":false,\"description\":\"Glob pattern like **/*.el or src/**/*.py\"},{\"name\":\"path\",\"type\":\"string\",\"optional\":true,\"description\":\"Directory to search in (default: project root)\"},{\"name\":\"offset\",\"type\":\"integer\",\"optional\":true,\"description\":\"Zero-based first result index\"},{\"name\":\"limit\",\"type\":\"integer\",\"optional\":true,\"description\":\"Maximum files per page (1-200)\"}],\"execution\":\"ogent-agent-call\",\"result\":\"structured data\",\"examples\":[\"(ogent-agent-call \\\"glob\\\" '(:pattern \\\"**/*.el\\\" :limit 20))\"],\"effects\":[{\"kind\":\"read\",\"target\":\"filesystem\",\"scope\":\"workspace\",\"risk\":\"low\"}]},{\"name\":\"grep\",\"aliases\":[\"search\"],\"description\":\"Search file contents using regex pattern. Uses ripgrep if available.\",\"category\":\"search\",\"enabled\":true,\"async\":false,\"async_sdk\":true,\"legacy_streaming\":true,\"boolean_representation\":\"native\",\"confirmation_required\":false,\"risk\":\"low\",\"arguments\":[{\"name\":\"pattern\",\"type\":\"string\",\"optional\":false,\"description\":\"Regular expression pattern to search for\"},{\"name\":\"path\",\"type\":\"string\",\"optional\":true,\"description\":\"File or directory to search\"},{\"name\":\"glob_filter\",\"type\":\"string\",\"optional\":true,\"description\":\"Limit search to files matching pattern (e.g., *.el)\"},{\"name\":\"context_lines\",\"type\":\"integer\",\"optional\":true,\"description\":\"Lines of context around matches\"}],\"call_arguments\":[{\"name\":\"pattern\",\"type\":\"string\",\"optional\":false,\"description\":\"Regular expression pattern to search for\"},{\"name\":\"path\",\"type\":\"string\",\"optional\":true,\"description\":\"File or directory to search\"},{\"name\":\"glob_filter\",\"type\":\"string\",\"optional\":true,\"description\":\"Limit search to files matching pattern (e.g., *.el)\"},{\"name\":\"context_lines\",\"type\":\"integer\",\"optional\":true,\"description\":\"Lines of context around matches\"},{\"name\":\"offset\",\"type\":\"integer\",\"optional\":true,\"description\":\"Zero-based first match index\"},{\"name\":\"limit\",\"type\":\"integer\",\"optional\":true,\"description\":\"Maximum match objects per page (1-200)\"}],\"execution\":\"ogent-agent-call\",\"result\":\"structured data\",\"examples\":[\"(ogent-agent-call \\\"grep\\\" '(:pattern \\\"defun\\\" :glob_filter \\\"*.el\\\" :limit 20))\"],\"effects\":[{\"kind\":\"read\",\"target\":\"filesystem\",\"scope\":\"workspace\",\"risk\":\"low\"}]},{\"name\":\"read-file\",\"aliases\":[\"read_file\",\"read\",\"cat\"],\"description\":\"Read the contents of a file. Returns lines with line numbers.\",\"category\":\"filesystem\",\"enabled\":true,\"async\":false,\"async_sdk\":false,\"legacy_streaming\":false,\"boolean_representation\":\"native\",\"confirmation_required\":false,\"risk\":\"low\",\"arguments\":[{\"name\":\"file_path\",\"type\":\"string\",\"optional\":false,\"description\":\"Absolute path to the file to read\"},{\"name\":\"offset\",\"type\":\"integer\",\"optional\":true,\"description\":\"Line number to start from (1-indexed)\"},{\"name\":\"limit\",\"type\":\"integer\",\"optional\":true,\"description\":\"Maximum lines to read\"}],\"call_arguments\":[{\"name\":\"file_path\",\"type\":\"string\",\"optional\":false,\"description\":\"Absolute path to the file to read\"},{\"name\":\"offset\",\"type\":\"integer\",\"optional\":true,\"description\":\"Line number to start from (1-indexed)\"},{\"name\":\"limit\",\"type\":\"integer\",\"optional\":true,\"description\":\"Maximum lines to read\"},{\"name\":\"column\",\"type\":\"integer\",\"optional\":true,\"description\":\"Starting column for a continued long line (1-indexed)\"}],\"execution\":\"ogent-agent-call\",\"result\":\"structured data\",\"examples\":[\"(ogent-agent-call \\\"read-file\\\" '(:file_path \\\"README.org\\\" :limit 40))\"],\"effects\":[{\"kind\":\"read\",\"target\":\"file\",\"scope\":\"workspace\",\"risk\":\"low\"}]},{\"name\":\"write-file\",\"aliases\":[\"write_file\",\"write\"],\"description\":\"Write content to a file, creating it if it doesn't exist.\",\"category\":\"filesystem\",\"enabled\":true,\"async\":false,\"async_sdk\":false,\"legacy_streaming\":false,\"boolean_representation\":\"native\",\"confirmation_required\":true,\"risk\":\"high\",\"arguments\":[{\"name\":\"file_path\",\"type\":\"string\",\"optional\":false,\"description\":\"Absolute path to write to\"},{\"name\":\"content\",\"type\":\"string\",\"optional\":false,\"description\":\"Content to write\"}],\"call_arguments\":[{\"name\":\"file_path\",\"type\":\"string\",\"optional\":false,\"description\":\"Absolute path to write to\"},{\"name\":\"content\",\"type\":\"string\",\"optional\":false,\"description\":\"Content to write\"}],\"execution\":\"ogent-agent-call\",\"result\":\"value envelope\",\"examples\":[\"(ogent-agent-call \\\"write-file\\\" '(:file_path \\\"notes.txt\\\" :content \\\"Reviewed content\\n\\\"))\"],\"effects\":[{\"kind\":\"write\",\"target\":\"file\",\"scope\":\"workspace\",\"risk\":\"high\"}]}],\"result_contract\":{\"tool_results\":\"ogent-agent-call returns versioned status/data/error/next envelopes; legacy functions default to text\",\"schema\":\"(ogent-agent-schema 'json)\",\"continuation\":\"(ogent-agent-next RESULT) follows the next page and guards snapshots\",\"batch\":\"ogent-agent-batch accepts up to 20 declared read-only calls\",\"async_sdk\":\"ogent-agent-call-async returns a process and invokes one terminal callback\",\"async_events\":[\"stdout\",\"stderr\",\"done\",\"error\"],\"doctor_exit_codes\":{\"ok\":0,\"warning\":1,\"error\":2}},\"discovery\":{\"guide\":\"(ogent-agent-guide)\",\"describe\":\"(ogent-agent-describe TOOL 'json)\",\"triage\":\"(ogent-agent-triage 'json)\",\"doctor\":\"(ogent-doctor-batch nil 'json)\"}}
"
FORM (ogent-tools-install-defaults)
RESULT nil
FORM (ogent-agent-describe "search" 'json)
RESULT "{\"contract_version\":\"1\",\"tool\":{\"name\":\"grep\",\"aliases\":[\"search\"],\"description\":\"Search file contents using regex pattern. Uses ripgrep if available.\",\"category\":\"search\",\"enabled\":true,\"async\":false,\"async_sdk\":true,\"legacy_streaming\":true,\"boolean_representation\":\"native\",\"confirmation_required\":false,\"risk\":\"low\",\"arguments\":[{\"name\":\"pattern\",\"type\":\"string\",\"optional\":false,\"description\":\"Regular expression pattern to search for\"},{\"name\":\"path\",\"type\":\"string\",\"optional\":true,\"description\":\"File or directory to search\"},{\"name\":\"glob_filter\",\"type\":\"string\",\"optional\":true,\"description\":\"Limit search to files matching pattern (e.g., *.el)\"},{\"name\":\"context_lines\",\"type\":\"integer\",\"optional\":true,\"description\":\"Lines of context around matches\"}],\"call_arguments\":[{\"name\":\"pattern\",\"type\":\"string\",\"optional\":false,\"description\":\"Regular expression pattern to search for\"},{\"name\":\"path\",\"type\":\"string\",\"optional\":true,\"description\":\"File or directory to search\"},{\"name\":\"glob_filter\",\"type\":\"string\",\"optional\":true,\"description\":\"Limit search to files matching pattern (e.g., *.el)\"},{\"name\":\"context_lines\",\"type\":\"integer\",\"optional\":true,\"description\":\"Lines of context around matches\"},{\"name\":\"offset\",\"type\":\"integer\",\"optional\":true,\"description\":\"Zero-based first match index\"},{\"name\":\"limit\",\"type\":\"integer\",\"optional\":true,\"description\":\"Maximum match objects per page (1-200)\"}],\"execution\":\"ogent-agent-call\",\"result\":\"structured data\",\"examples\":[\"(ogent-agent-call \\\"grep\\\" '(:pattern \\\"defun\\\" :glob_filter \\\"*.el\\\" :limit 20))\"],\"effects\":[{\"kind\":\"read\",\"target\":\"filesystem\",\"scope\":\"workspace\",\"risk\":\"low\"}]},\"result_schema\":\"(ogent-agent-schema 'json)\"}
"
