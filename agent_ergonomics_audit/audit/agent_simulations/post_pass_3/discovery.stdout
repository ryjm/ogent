RESULT "{\"contract_version\":\"1\",\"tool\":{\"name\":\"bash\",\"aliases\":[\"shell\",\"run\"],\"description\":\"Execute a shell command and return output.\",\"category\":\"shell\",\"enabled\":true,\"async\":false,\"async_sdk\":true,\"legacy_streaming\":true,\"boolean_representation\":\"native\",\"confirmation_required\":true,\"risk\":\"critical\",\"arguments\":[{\"name\":\"command\",\"type\":\"string\",\"optional\":false,\"description\":\"Shell command to execute\"},{\"name\":\"working_directory\",\"type\":\"string\",\"optional\":true,\"description\":\"Directory to run command in\"},{\"name\":\"timeout\",\"type\":\"number\",\"optional\":true,\"description\":\"Timeout in seconds\"}],\"call_arguments\":[{\"name\":\"command\",\"type\":\"string\",\"optional\":false,\"description\":\"Shell command to execute\"},{\"name\":\"working_directory\",\"type\":\"string\",\"optional\":true,\"description\":\"Directory to run command in\"},{\"name\":\"timeout\",\"type\":\"number\",\"optional\":true,\"description\":\"Timeout in seconds\"}],\"execution\":\"ogent-agent-call\",\"result\":\"structured data\",\"examples\":[\"(ogent-agent-call \\\"bash\\\" '(:command \\\"pwd\\\" :timeout 10))\"],\"effects\":[{\"kind\":\"execute\",\"target\":\"shell\",\"scope\":\"unrestricted\",\"risk\":\"critical\"},{\"kind\":\"read\",\"target\":\"filesystem\",\"scope\":\"unrestricted\",\"risk\":\"high\"},{\"kind\":\"write\",\"target\":\"filesystem\",\"scope\":\"unrestricted\",\"risk\":\"high\"},{\"kind\":\"network\",\"target\":\"external\",\"scope\":\"command\",\"risk\":\"high\"}]},\"result_schema\":\"(ogent-agent-schema 'json)\"}
